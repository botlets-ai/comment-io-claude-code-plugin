#!/bin/sh
set -eu
input=$(cat || true)
event=$(printf '%s' "$input" | sed -n 's/.*"hook_event_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
session=$(printf '%s' "$input" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
case "$session" in ''|*[!A-Za-z0-9._:-]*) exit 0 ;; esac
CLAUDE_CODE_SESSION_ID=$session
export CLAUDE_CODE_SESSION_ID
case "$event" in
  Stop) exec "${CLAUDE_PLUGIN_ROOT:?}/runtime/comment-plugin" hook ;;
  SessionEnd) exec "${CLAUDE_PLUGIN_ROOT:?}/runtime/comment-plugin" listen stop ;;
  *) exit 0 ;;
esac
